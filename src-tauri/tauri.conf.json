{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horaka Desktop",
  "version": "1.1.1",
  "identifier": "com.horaka.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Horaka",
        "width": 360,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": true,
        "focus": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "giant Computer Systems",
    "copyright": "© 2026 giant Computer Systems",
    "category": "Productivity",
    "shortDescription": "Horaka timer in the tray and menu bar",
    "homepage": "https://www.horaka.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English",
          "French",
          "Spanish",
          "Italian",
          "Dutch",
          "Polish",
          "Portuguese"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5MTQ2MDBGMTlFNTE1RDgKUldUWUZlVVpEMkFVaWFLNVhVNXpQbit5ci9qTURCZmpwRmQ2OE9RemRDRUpNV2JhN1hCZXc1V1MK",
      "endpoints": [
        "https://github.com/s1nn3r/horaka-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
